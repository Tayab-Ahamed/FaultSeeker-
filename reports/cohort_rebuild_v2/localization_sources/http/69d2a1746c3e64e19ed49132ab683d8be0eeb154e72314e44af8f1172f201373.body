"to":"This address must've approved the from address, or be a sub-account of msg.sender"}}},"version":1},"userdoc":{"kind":"user","methods":{"approveDebt(uint256,address,uint256)":{"notice":"Allow spender to send an amount of dTokens to a particular sub-account"},"balanceOf(address)":{"notice":"Debt owed by a particular account, in underlying units"},"balanceOfExact(address)":{"notice":"Debt owed by a particular account, in underlying units normalized to 27 decimals"},"borrow(uint256,uint256)":{"notice":"Transfer underlying tokens from the Euler pool to the sender, and increase sender's dTokens"},"debtAllowance(address,address)":{"notice":"Retrieve the current debt allowance"},"decimals()":{"notice":"Decimals of underlying"},"flashLoan(uint256,bytes)":{"notice":"Request a flash-loan. A onFlashLoan() callback in msg.sender will be invoked, which must repay the loan to the main Euler address prior to returning."},"name()":{"notice":"Debt token name, ie \"Euler Debt: DAI\""},"repay(uint256,uint256)":{"notice":"Transfer underlying tokens from the sender to the Euler pool, and decrease sender's dTokens"},"symbol()":{"notice":"Debt token symbol, ie \"dDAI\""},"totalSupply()":{"notice":"Sum of all outstanding debts, in underlying units (increases as interest is accrued)"},"totalSupplyExact()":{"notice":"Sum of all outstanding debts, in underlying units normalized to 27 decimals (increases as interest is accrued)"},"transfer(address,uint256)":{"notice":"Transfer dTokens to another address (from sub-account 0)"},"transferFrom(address,address,uint256)":{"notice":"Transfer dTokens from one address to another"},"underlyingAsset()":{"notice":"Address of underlying asset"}},"notice":"Tokenised representation of debts","version":1}},"settings":{"compilationTarget":{"contracts/modules/DToken.sol":"DToken"},"evmVersion":"london","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":1000000},"remappings":[]},"sources":{"contracts/Base.sol":{"keccak256":