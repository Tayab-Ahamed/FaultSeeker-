\",\"type\":\"bool\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"from\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"}],\"name\":\"transferFrom\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"underlyingAsset\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{\"approveDebt(uint256,address,uint256)\":{\"params\":{\"amount\":\"In underlying units (use max uint256 for \\\"infinite\\\" allowance)\",\"spender\":\"Trusted address\",\"subAccountId\":\"0 for primary, 1-255 for a sub-account\"}},\"borrow(uint256,uint256)\":{\"params\":{\"amount\":\"In underlying units (use max uint256 for all available tokens)\",\"subAccountId\":\"0 for primary, 1-255 for a sub-account\"}},\"debtAllowance(address,address)\":{\"params\":{\"holder\":\"Xor with the desired sub-account ID (if applicable)\",\"spender\":\"Trusted address\"}},\"flashLoan(uint256,bytes)\":{\"params\":{\"amount\":\"In underlying units\",\"data\":\"Passed through to the onFlashLoan() callback, so contracts don't need to store transient data in storage\"}},\"repay(uint256,uint256)\":{\"params\":{\"amount\":\"In underlying units (use max uint256 for full debt owed)\",\"subAccountId\":\"0 for primary, 1-255 for a sub-account\"}},\"transfer(address,uint256)\":{\"params\":{\"amount\":\"In underlying units. Use max uint256 for full balance.\",\"to\":\"Xor with the desired sub-account ID (if applicable)\"}},\"transferFrom(address,address,uint256)\":{\"params\":{\"amount\":\"In underlying units. Use max uint256 for full balance.\",\"from\":\"Xor with the desired sub-account ID (if applicable)\",\"to\":\"This address must've approved the from address, or be a sub-account of msg.sender\"}}},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"approveDebt(uint256,address,uint256)\":{\"notice\":\"Allow spender to send an amount of dTokens to a particular sub-account\"},\"balanceOf(address)\":{\"notice\":\"Debt owed by a particular account, in underlying units\"},\"balanceOfExact(address)\":{\"notice\":\"Debt owed by a particular account, in underlying units normalized to 27 decimals\"},\"borrow(uint256,uint256)\":{\"notice\":\"Transfer underlying tokens from the Euler pool to the sender, and increase sender's dTokens\"},\"debtAllowance(address,address)\":{\"notice\":\"Retrieve the current debt allowance\"},\"decimals()\":{\"notice\":\"Decimals of underlying\"},\"flashLoan(uint256,bytes)\":{\"notice\":\"Request a flash-loan. A onFlashLoan() callback in msg.sender will be invoked, which must repay the loan to the main Euler address prior to returning.\"},\"name()\":{\"notice\":\"Debt token name, ie \\\"Euler Debt: DAI\\\"\"},\"repay(uint256,uint256)\":{\"notice\":\"Transfer underlying tokens from the sender to the Euler pool, and decrease sender's dTokens\"},\"symbol()\":{\"notice\":\"Debt token symbol, ie \\\"dDAI\\\"\"},\"totalSupply()\":{\"notice\":\"Sum of all outstanding debts, in underlying units (increases as interest is accrued)\"},\"totalSupplyExact()\":{\"notice\":\"Sum of all outstanding debts, in underlying units normalized to 27 decimals (increases as interest is accrued)\"},\"transfer(address,uint256)\":{\"notice\":\"Transfer dTokens to another address (from sub-account 0)\"},\"transferFrom(address,address,uint256)\":{\"notice\":\"Transfer dTokens from one address to another\"},\"underlyingAsset()\":{\"notice\":\"Address of underlying asset\"}},\"notice\":\"Tokenised representation of debts\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"contracts/modules/DToken.sol\":\"DToken\"},\"evmVersion\":\"london\",\"libraries\":{},\"metadata\":{\"bytecodeHa