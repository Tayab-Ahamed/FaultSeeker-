\":1}","userdoc":{"kind":"user","notice":"Tokenised representation of debts","methods":{"name()":{"notice":"Debt token name, ie \"Euler Debt: DAI\""},"symbol()":{"notice":"Debt token symbol, ie \"dDAI\""},"decimals()":{"notice":"Decimals of underlying"},"totalSupply()":{"notice":"Sum of all outstanding debts, in underlying units (increases as interest is accrued)"},"underlyingAsset()":{"notice":"Address of underlying asset"},"balanceOf(address)":{"notice":"Debt owed by a particular account, in underlying units"},"totalSupplyExact()":{"notice":"Sum of all outstanding debts, in underlying units normalized to 27 decimals (increases as interest is accrued)"},"repay(uint256,uint256)":{"notice":"Transfer underlying tokens from the sender to the Euler pool, and decrease sender's dTokens"},"balanceOfExact(address)":{"notice":"Debt owed by a particular account, in underlying units normalized to 27 decimals"},"borrow(uint256,uint256)":{"notice":"Transfer underlying tokens from the Euler pool to the sender, and increase sender's dTokens"},"flashLoan(uint256,bytes)":{"notice":"Request a flash-loan. A onFlashLoan() callback in msg.sender will be invoked, which must repay the loan to the main Euler address prior to returning."},"transfer(address,uint256)":{"notice":"Transfer dTokens to another address (from sub-account 0)"},"debtAllowance(address,address)":{"notice":"Retrieve the current debt allowance"},"approveDebt(uint256,address,uint256)":{"notice":"Allow spender to send an amount of dTokens to a particular sub-account"},"transferFrom(address,address,uint256)":{"notice":"Transfer dTokens from one address to another"}},"version":1},"devdoc":{"kind":"dev","methods":{"repay(uint256,uint256)":{"params":{"amount":"In underlying units (use max uint256 for full debt owed)","subAccountId":"0 for primary, 1-255 for a sub-account"}},"borrow(uint256,uint256)":{"params":{"amount":"In underlying units (use max uint256 for all available tokens)","subAccountId":"0 for primary, 1-255 for a sub-account"}},"flashLoan(uint256,bytes)":{"params":{"data":"Passed through to the onFlashLoan() callback, so contracts don't need to store transient data in storage","amount":"In underlying units"}},"transfer(address,uint256)":{"params":{"to":"Xor with the desired sub-account ID (if applicable)","amount":"In underlying units. Use max uint256 for full balance."}},"debtAllowance(address,address)":{"params":{"holder":"Xor with the desired sub-account ID (if applicable)","spender":"Trusted address"}},"approveDebt(uint256,address,uint256)":{"params":{"amount":"In underlying units (use max uint256 for \"infinite\" allowance)","spender":"Trusted address","subAccountId":"0 for primary, 1-255 for a sub-account"}},"transferFrom(address,address,uint256)":{"params":{"to":"This address must've approved the from address, or be a sub-account of msg.sender","from":"Xor with the desired sub-account ID (if applicable)","amount":"In underlying units. Use max uint256 for full balance."}}},"version":1},"storageLayout":{"types":{"t_bool":{"label":"bool","encoding":"inplace","numberOfBytes":"1"},"t_int96":{"label":"int96","encoding":"inplace","numberOfBytes":"12"},"t_uint8":{"label":"uint8","encoding":"inplace","numberOfBytes":"1"},"t_uint16":{"label":"uint16","encoding":"inplace","numberOfBytes":"2"},"t_uint24":{"label":"uint24","encoding":"inplace","numberOfBytes":"3"},"t_uint32":{"label":"uint32","encoding":"inplace","numberOfBytes":"4"},"t_uint40":{"label":"uint40","encoding":"inplace","numberOfBytes":"5"},"t_uint96":{"label":"uint96","encoding":"inplace","numberOfBytes":"12"},"t_address":{"label":"address","encoding":"inplace","numberOfBytes":"20"},"t_uint112":{"label":"uint112","encoding":"inplace","numberOfBytes":"14"},"t_uint144":{"label":"uint144","encoding":"inplace","numberOfBytes":"18"},"t_uint256":{"label":"uint256","encoding":"inplace","numberOfBytes":"32"},"t_mapping(t_address,t_address)":{"key":"t_address","label":"mapping(address => address)","value":"t_address","encoding