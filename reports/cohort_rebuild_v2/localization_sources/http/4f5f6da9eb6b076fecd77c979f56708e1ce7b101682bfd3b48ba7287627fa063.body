tability":"view"},{"name":"getSplitsRemaining","type":"function","inputs":[{"name":"fnftId","type":"uint256","internalType":"uint256"}],"outputs":[{"name":"","type":"uint256","internalType":"uint256"}],"stateMutability":"view"},{"name":"grantRole","type":"function","inputs":[{"name":"role","type":"bytes32","internalType":"bytes32"},{"name":"account","type":"address","internalType":"address"}],"outputs":[],"stateMutability":"nonpayable"},{"name":"handleMultipleDeposits","type":"function","inputs":[{"name":"fnftId","type":"uint256","internalType":"uint256"},{"name":"newFNFTId","type":"uint256","internalType":"uint256"},{"name":"amount","type":"uint256","internalType":"uint256"}],"outputs":[],"stateMutability":"nonpayable"},{"name":"hasRole","type":"function","inputs":[{"name":"role","type":"bytes32","internalType":"bytes32"},{"name":"account","type":"address","internalType":"address"}],"outputs":[{"name":"","type":"bool","internalType":"bool"}],"stateMutability":"view"},{"name":"mapFNFTToToken","type":"function","inputs":[{"name":"fnftId","type":"uint256","internalType":"uint256"},{"name":"fnftConfig","type":"tuple","components":[{"name":"asset","type":"address","internalType":"address"},{"name":"pipeToContract","type":"address","internalType":"address"},{"name":"depositAmount","type":"uint256","internalType":"uint256"},{"name":"depositMul","type":"uint256","internalType":"uint256"},{"name":"split","type":"uint256","internalType":"uint256"},{"name":"depositStopTime","type":"uint256","internalType":"uint256"},{"name":"maturityExtension","type":"bool","internalType":"bool"},{"name":"isMulti","type":"bool","internalType":"bool"},{"name":"nontransferrable","type":"bool","internalType":"bool"}],"internalType":"struct IRevest.FNFTConfig"}],"outputs":[],"stateMutability":"nonpayable"},{"name":"owner","type":"function","inputs":[],"outputs":[{"name":"","type":"address","internalType":"address"}],"stateMutability":"view"},{"name":"renounceOwnership","type":"function","inputs":[],"outputs":[],"stateMutability":"nonpayable"},{"name":"renounceRole","type":"function","inputs":[{"name":"role","type":"bytes32","internalType":"bytes32"},{"name":"account","type":"address","internalType":"address"}],"outputs":[],"stateMutability":"nonpayable"},{"name":"revokeRole","type":"function","inputs":[{"name":"role","type":"bytes32","internalType":"bytes32"},{"name":"account","type":"address","internalType":"address"}],"outputs":[],"stateMutability":"nonpayable"},{"name":"setAddressRegistry","type":"function","inputs":[{"name":"registry","type":"address","internalType":"address"}],"outputs":[],"stateMutability":"nonpayable"},{"name":"splitFNFT","type":"function","inputs":[{"name":"fnftId","type":"uint256","internalType":"uint256"},{"name":"newFNFTIds","type":"uint256[]","internalType":"uint256[]"},{"name":"proportions","type":"uint256[]","internalType":"uint256[]"},{"name":"quantity","type":"uint256","internalType":"uint256"}],"outputs":[],"stateMutability":"nonpayable"},{"name":"supportsInterface","type":"function","inputs":[{"name":"interfaceId","type":"bytes4","internalType":"bytes4"}],"outputs":[{"name":"","type":"bool","internalType":"bool"}],"stateMutability":"view"},{"name":"tokenTrackers","type":"function","inputs":[{"name":"","type":"address","internalType":"address"}],"outputs":[{"name":"lastBalance","type":"uint256","internalType":"uint256"},{"name":"lastMul","type":"uint256","internalType":"uint256"}],"stateMutability":"view"},{"name":"transferOwnership","type":"function","inputs":[{"name":"newOwner","type":"address","internalType":"address"}],"outputs":[],"stateMutability":"nonpayable"},{"name":"withdrawToken","type":"function","inputs":[{"name":"fnftId","type":"uint256","internalType":"uint256"},{"name":"quantity","type":"uint256","internalType":"uint256"},{"name":"user","type":"address","internalType":"address"}],"outputs":[],"stateMutability":"nonpayable"}],"metadata":{"compiler":{"version":"0.8.4+commit.c7e474f2"},"language":"Solidity","ou