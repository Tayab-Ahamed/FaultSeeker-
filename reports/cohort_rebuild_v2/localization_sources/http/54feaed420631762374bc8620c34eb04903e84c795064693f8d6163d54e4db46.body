ing units (non-increasing)"},"burn(uint256,uint256)":{"notice":"Pay off dToken liability with eTokens (\"self-repay\")"},"mint(uint256,uint256)":{"notice":"Mint eTokens and a corresponding amount of dTokens (\"self-borrow\")"},"totalSupplyUnderlying()":{"notice":"Sum of all balances, in underlying units (increases as interest is earned)"},"approve(address,uint256)":{"notice":"Allow spender to access an amount of your eTokens in sub-account 0"},"deposit(uint256,uint256)":{"notice":"Transfer underlying tokens from sender to the Euler pool, and increase account's eTokens"},"transfer(address,uint256)":{"notice":"Transfer eTokens to another address (from sub-account 0)"},"withdraw(uint256,uint256)":{"notice":"Transfer underlying tokens from Euler pool to sender, and decrease account's eTokens"},"allowance(address,address)":{"notice":"Retrieve the current allowance"},"reserveBalanceUnderlying()":{"notice":"Balance of the reserves, in underlying units (increases as interest is earned)"},"balanceOfUnderlying(address)":{"notice":"Balance of a particular account, in underlying units (increases as interest is earned)"},"transferFromMax(address,address)":{"notice":"Transfer the full eToken balance of an address to another"},"donateToReserves(uint256,uint256)":{"notice":"Donate eTokens to the reserves"},"convertBalanceToUnderlying(uint256)":{"notice":"Convert an eToken balance to an underlying amount, taking into account current exchange rate"},"convertUnderlyingToBalance(uint256)":{"notice":"Convert an underlying amount to an eToken balance, taking into account current exchange rate"},"transferFrom(address,address,uint256)":{"notice":"Transfer eTokens from one address to another"},"approveSubAccount(uint256,address,uint256)":{"notice":"Allow spender to access an amount of your eTokens in a particular sub-account"}},"version":1},"devdoc":{"kind":"dev","methods":{"burn(uint256,uint256)":{"params":{"amount":"In underlying units (use max uint256 to repay the debt in full or up to t