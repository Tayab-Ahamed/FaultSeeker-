56 for \\\"infinite\\\" allowance\",\"spender\":\"Trusted address\"}},\"approveSubAccount(uint256,address,uint256)\":{\"params\":{\"amount\":\"Use max uint256 for \\\"infinite\\\" allowance\",\"spender\":\"Trusted address\",\"subAccountId\":\"0 for primary, 1-255 for a sub-account\"}},\"burn(uint256,uint256)\":{\"params\":{\"amount\":\"In underlying units (use max uint256 to repay the debt in full or up to the available underlying balance)\",\"subAccountId\":\"0 for primary, 1-255 for a sub-account\"}},\"convertBalanceToUnderlying(uint256)\":{\"params\":{\"balance\":\"eToken balance, in internal book-keeping units (18 decimals)\"},\"returns\":{\"_0\":\"Amount in underlying units, (same decimals as underlying token)\"}},\"convertUnderlyingToBalance(uint256)\":{\"params\":{\"underlyingAmount\":\"Amount in underlying units (same decimals as underlying token)\"},\"returns\":{\"_0\":\"eToken balance, in internal book-keeping units (18 decimals)\"}},\"deposit(uint256,uint256)\":{\"params\":{\"amount\":\"In underlying units (use max uint256 for full underlying token balance)\",\"subAccountId\":\"0 for primary, 1-255 for a sub-account\"}},\"donateToReserves(uint256,uint256)\":{\"params\":{\"amount\":\"In internal book-keeping units (as returned from balanceOf).\",\"subAccountId\":\"0 for primary, 1-255 for a sub-account\"}},\"mint(uint256,uint256)\":{\"params\":{\"amount\":\"In underlying units\",\"subAccountId\":\"0 for primary, 1-255 for a sub-account\"}},\"transfer(address,uint256)\":{\"params\":{\"amount\":\"In internal book-keeping units (as returned from balanceOf).\",\"to\":\"Xor with the desired sub-account ID (if applicable)\"}},\"transferFrom(address,address,uint256)\":{\"params\":{\"amount\":\"In internal book-keeping units (as returned from balanceOf).\",\"from\":\"This address must've approved the to address, or be a sub-account of msg.sender\",\"to\":\"Xor with the desired sub-account ID (if applicable)\"}},\"transferFromMax(address,address)\":{\"params\":{\"from\":\"This address must've approved the to address, or be a sub-account of msg.sender\",\"to\":\"Xor with the desired sub-account ID (if applicable)\"}},\"withdraw(uint256,uint256)\":{\"params\":{\"amount\":\"In underlying units (use max uint256 for full pool balance)\",\"subAccountId\":\"0 for primary, 1-255 for a sub-account\"}}},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"allowance(address,address)\":{\"notice\":\"Retrieve the current allowance\"},\"approve(address,uint256)\":{\"notice\":\"Allow spender to access an amount of your eTokens in sub-account 0\"},\"approveSubAccount(uint256,address,uint256)\":{\"notice\":\"Allow spender to access an amount of your eTokens in a particular sub-account\"},\"balanceOf(address)\":{\"notice\":\"Balance of a particular account, in internal book-keeping units (non-increasing)\"},\"balanceOfUnderlying(address)\":{\"notice\":\"Balance of a particular account, in underlying units (increases as interest is earned)\"},\"burn(uint256,uint256)\":{\"notice\":\"Pay off dToken liability with eTokens (\\\"self-repay\\\")\"},\"convertBalanceToUnderlying(uint256)\":{\"notice\":\"Convert an eToken balance to an underlying amount, taking into account current exchange rate\"},\"convertUnderlyingToBalance(uint256)\":{\"notice\":\"Convert an underlying amount to an eToken balance, taking into account current exchange rate\"},\"decimals()\":{\"notice\":\"Decimals, always normalised to 18.\"},\"deposit(uint256,uint256)\":{\"notice\":\"Transfer underlying tokens from sender to the Euler pool, and increase account's eTokens\"},\"donateToReserves(uint256,uint256)\":{\"notice\":\"Donate eTokens to the reserves\"},\"mint(uint256,uint256)\":{\"notice\":\"Mint eTokens and a corresponding amount of dTokens (\\\"self-borrow\\\")\"},\"name()\":{\"notice\":\"Pool name, ie \\\"Euler Pool: DAI\\\"\"},\"reserveBalance()\":{\"notice\":\"Balance of the reserves, in internal book-keeping units (non-increasing)\"},\"reserveBalanceUnderlying()\":{\"notice\":\"Balance of the reserves, in underlying units (increases as interest is earned)\"},\"symbol()\":{\"notice\":\"Pool symbol, ie \\\"eDAI\\\"\"},\"totalSupply()\":{\"notice\":\"Sum of all balances, in internal book-keeping units (non-increasing)\"},\"totalSupplyUnderlying()\":{\"notice\":\"Sum of all balances, in underlying units (increases as interest is earned)\"},\"touch()\":{\"notice\":\"Updates interest accumulator and totalBorrows, credits reserves, re-targets interest rate, and logs asset status\"},\"transfer(address,uint256)\":{\"notice\":\"Transfer eTokens to another address (from sub-account 0)\"},\"transferFrom(address,address,uint256)\":{\"notice\":\"Transfer eTokens from one address to another\"},\"transferFromMax(address,address)\":{\"notice\":\"Transfer the full eToken balance of an address to another\"},\"underlyingAsset()\":{\"notice\":\"Address of underlying asset\"},\"withdraw(uint256,uint256)\":{\"notice\":\"Transfer underlying tokens from Euler pool to sender, and decrease account's eTokens\"}},\"notice\":\"Tokenised representation of assets\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"contracts/modules/EToken.sol\":\"EToken\"},\"evmVersion\":\"london\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":1000000},\"remappings\":[]},\"sources\":{\"contracts/Base.sol\":{\"keccak256\":\"0x274734b430e12e7defb4964499a4e40399c541406103f25225e448d588b94b9c\",\"license\":\"GPL-2.0-or-later\",\"urls\":[\"bzz-raw://98f330c4cabf765cc1f4ffb544f84f77c0eaeb51387b9ae08bd8145f8c43e813\",\"dweb:/ipfs/QmTRF8w8qAXNPpcvHjC1meJBoyVDfcFfMYHDcDCUu9qJ6X\"]},\"contracts/BaseIRM.sol\":{\"keccak256\":\"0x8f53f8edfd595b4cb8a268cae43bb00e6c1ca7ecd57b310a0729396369fea9b8\",\"license\":\"GPL-2.0-or-later\",\"urls\":[\"bzz-raw://86ddf675a445d75f340403db7880ee89cedd6351ee1762888ac90df4ce1bc427\",\"dweb:/ipfs/QmSQpvZqyeneyDGAyzgjMYQSajQ4ko6HZqHSYJ2zmZj8Ea\"]},\"contracts/BaseLogic.sol\":{\"keccak256\":\"0xa788