# FaultSeeker++ Environment Configuration
# Copy this file to .env and fill in your API keys
# Only ONE cloud provider is needed — pick the one you have access to

# ── Cloud LLM Providers (pick at least one) ────────────────────────────

# OpenAI (gpt-4o, gpt-4o-mini, gpt-4.1, o3-mini, ...)
OPENAI_API_KEY=sk-...

# xAI Grok (grok-3, grok-3-mini, grok-2, ...)
# Docs: https://console.x.ai/
XAI_API_KEY=xai-...

# Alibaba Qwen via DashScope (qwen-max, qwen-plus, qwen-turbo, ...)
# Docs: https://dashscope.aliyuncs.com
DASHSCOPE_API_KEY=sk-...

# Google Gemini (gemini-2.0-flash, gemini-1.5-pro, ...)
# Docs: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...

# Anthropic Claude (claude-3-5-sonnet, claude-3-haiku, ...) [optional]
ANTHROPIC_API_KEY=sk-ant-...

# ── Chain Explorer API Keys (for source code download) ────────────────
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
ARBISCAN_API_KEY=
OPTIMISM_API_KEY=
BASESCAN_API_KEY=
POLYGONSCAN_API_KEY=
SNOWTRACE_API_KEY=
ZKSYNC_API_KEY=

# ── Archive-Capable RPC URLs (defaults are free Ankr public nodes) ────
# Leave blank to use built-in defaults, or replace with your own
ETH_RPC_URL=https://rpc.ankr.com/eth
BSC_RPC_URL=https://rpc.ankr.com/bsc
ARBITRUM_RPC_URL=https://rpc.ankr.com/arbitrum
OPTIMISM_RPC_URL=https://rpc.ankr.com/optimism
BASE_RPC_URL=https://rpc.ankr.com/base
POLYGON_RPC_URL=https://rpc.ankr.com/polygon
AVALANCHE_RPC_URL=https://rpc.ankr.com/avalanche
ZKSYNC_RPC_URL=https://rpc.ankr.com/zksync_era
